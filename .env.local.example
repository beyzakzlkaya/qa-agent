# LLM Configuration (page-agent için gerekli)
#
# ⚠️  ÖNEMLI: page-agent, OpenAI `/v1/chat/completions` formatını kullanır.
#    Anthropic (api.anthropic.com) bu endpoint'i DOĞRUDAN desteklemez.
#    Claude kullanmak için OpenRouter üzerinden erişin.
#
# ── OpenRouter üzerinden Claude (ÖNERİLEN) ──────────────────────────────────
# https://openrouter.ai/keys adresinden ücretsiz API key alın
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=sk-or-v1-BURAYA_OPENROUTER_ANAHTARINI_YAZ
LLM_MODEL_NAME=anthropic/claude-haiku-4-5

# ── OpenAI (alternatif) ──────────────────────────────────────────────────────
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-...
# LLM_MODEL_NAME=gpt-4o

# ── Qwen / Alibaba (alternatif) ──────────────────────────────────────────────
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_API_KEY=sk-...
# LLM_MODEL_NAME=qwen-plus

# ── LiteLLM local proxy (Anthropic dahil her şey için) ───────────────────────
# LLM_BASE_URL=http://localhost:4000/v1
# LLM_API_KEY=anything
# LLM_MODEL_NAME=claude-haiku-4-5

# ── Multi-Provider LLM (LLM_BASE_URL/API_KEY/MODEL_NAME yoksa kullanılır) ────
# LLM_PROVIDER değeri "anthropic" veya "openai" olabilir (varsayılan: "anthropic")
# LLM_PROVIDER=anthropic

# Anthropic (direkt — bridge /anthropic-proxy/* üzerinden yönlendirir)
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
# ANTHROPIC_DEFAULT_MODEL=claude-haiku-4-5

# OpenAI (alternatif — bridge /openai-proxy/* üzerinden yönlendirir)
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_DEFAULT_MODEL=gpt-4o

# Page Agent Hub Port (varsayılan: 38401)
PAGE_AGENT_PORT=38401

# Next.js port
PORT=3000

# ── JIRA REST API ──────────────────────────────────────────────────────────────
# https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_BASE_URL=https://yourcompany.atlassian.net
JIRA_EMAIL=you@yourcompany.com
JIRA_API_TOKEN=ATATT3x...
JIRA_PROJECT_KEY=NE

# ── GitHub REST API ────────────────────────────────────────────────────────────
# Token oluşturun: https://github.com/settings/tokens (classic, repo scope)
# Org private repolarına erişmek için token'da SSO → Authorize zorunlu
GITHUB_TOKEN=ghp_...
# Getmobil org altındaki PR arama repoları (virgülle ayrılmış liste)
# Önce org:Getmobil ile tüm org'da aranır; bulunamazsa bu listede sırayla taranır
GITHUB_REPO_OWNER=Getmobil
GITHUB_REPOS=Getmobil/{reponame}
# E2E test prompt library reposu (context-cache.ts kullanır)
PROMPT_LIBRARY_REPO_NAME=getmobil-e2e-test-prompt-library

# ── Domain Agent (RAG) ────────────────────────────────────────────────────────
# GitHub repo indexing için yukarıdaki GITHUB_TOKEN kullanılır
GITHUB_OWNER=Getmobil
GITHUB_REPO=getmobil-e2e-test-prompt-library
# Embedding modeli: voyage-3 (Voyage AI) veya uyumlu model
EMBEDDING_MODEL=voyage-3
# Voyage AI API key (https://www.voyageai.com — isteğe bağlı, yoksa ANTHROPIC_API_KEY kullanılır)
# VOYAGE_API_KEY=pa-...

# ── Screenshot ────────────────────────────────────────────────────────────────
# Screenshot dosyaları data/screenshots/ klasörüne kaydedilir
SCREENSHOT_MAX_SIZE_MB=5
SCREENSHOT_BASELINE_ENABLED=false

# ── Slack Notifications ───────────────────────────────────────────────────────
# Run bittiğinde Slack kanalına özet otomatik gönderilir.
# Webhook tanımlanmazsa bildirim atlanır (no-op).
# Incoming Webhook URL: https://api.slack.com/messaging/webhooks
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T000/B000/XXXX

# Slack mesajındaki "Canlı Run" / "Detaylı Rapor" butonları için uygulamanın
# dış erişilebilir adresi. Dev'de http://localhost:3000 yeterlidir.
# NEXT_PUBLIC_APP_URL=http://localhost:3000
