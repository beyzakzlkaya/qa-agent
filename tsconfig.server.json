{
  "compilerOptions": {
    "lib": ["esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "esModuleInterop": true,
    "module": "commonjs",
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "outDir": "./dist-server",
    "target": "ES2020",
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": ["server/**/*.ts", "scripts/**/*.ts", "lib/**/*.ts", "data/**/*.json", "types/**/*.d.ts"],
  "exclude": ["node_modules", "app", ".next"]
}
